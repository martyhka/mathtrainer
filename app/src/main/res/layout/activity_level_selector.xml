<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btnLevel1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Уровень 1 (целые)" />

    <Button
        android:id="@+id/btnLevel2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Уровень 2 (десятичные)"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnLevel3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Уровень 3 (удали лишнее)"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnMarathon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Марафон (Ур.1 → Ур.2 → Ур.3)"
        android:layout_marginTop="16dp"/>


</LinearLayout>
